# Copy to .env and fill in values

DATABASE_URL=postgresql://postgres:password@localhost:5432/hausbank_incident

# Add your Anthropic API key here — leave empty to run in mock mode (demo works without it)
ANTHROPIC_API_KEY=

ENVIRONMENT=development
HEALER_CONFIDENCE_THRESHOLD=0.85
SIMILARITY_TOP_K=10
MAX_HOP_COUNT=3
MAX_RESOLUTION_MINUTES=20
